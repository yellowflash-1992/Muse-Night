// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Person {
  id             String          @id
  legalName      String
  role           String
  bio            String
  longBio        String
  aesthetic      String
  imageUrl       String?
  literaryWorlds LiteraryWorld[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model LiteraryWorld {
  id          String @id
  name        String
  creatorId   String
  description String
  creator     Person @relation(fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}
