// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  EDITOR
  ADMIN
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Person {
  id             String          @id
  legalName      String
  role           String
  bio            String
  longBio        String
  aesthetic      String
  imageUrl       String?
  userId         String?         @unique
  literaryWorlds LiteraryWorld[]
  penNames       PenName[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model MemberProfile {
  id                      String               @id
  displayName             String
  penName                 String?
  profileTitle            String               @default("Reader & Patron")
  bio                     String?
  avatarUrl               String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  userRole                UserRole?
  founderAdmin            FounderAdmin?
  submittedAccessRequests AdminAccessRequest[] @relation("AdminAccessRequester")
  reviewedAccessRequests  AdminAccessRequest[] @relation("AdminAccessReviewer")
}

model UserRole {
  userId    String        @id
  role      AppRole
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  member    MemberProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
}

model FounderAdmin {
  slot      Int           @id
  userId    String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  member    MemberProfile @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model AdminAccessRequest {
  id              String              @id @default(cuid())
  requesterId     String
  requestedRole   AppRole             @default(ADMIN)
  status          AccessRequestStatus @default(PENDING)
  reviewerId      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  requester MemberProfile  @relation("AdminAccessRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  MemberProfile? @relation("AdminAccessReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([requesterId])
  @@index([reviewerId])
  @@index([status])
}

model LiteraryWorld {
  id          String     @id
  name        String
  creatorId   String
  description String
  creator     Person     @relation(fields: [creatorId], references: [id])
  penNames    PenName[]
  poems       Poem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([creatorId])
}

model PenName {
  id                  String         @id
  name                String         @unique
  personId            String
  person              Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  title               String?
  description         String?
  literaryIdentity    String?
  isPrimary           Boolean        @default(false)
  literaryWorldId     String?
  literaryWorld       LiteraryWorld? @relation(fields: [literaryWorldId], references: [id], onDelete: SetNull)
  poems               Poem[]
  authoredCollections Collection[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
    chapbooks           Chapbook[]

  @@index([personId])
  @@index([literaryWorldId])
}

model Collection {
  id            String            @id
  title         String
  subtitle      String?
  description   String
  foreword      String?
  featuredQuote String?
  coverImage    String?
  status        PublicationStatus @default(DRAFT)
  authorId      String
  author        PenName           @relation(fields: [authorId], references: [id])
  year          String
  tags          String[]
  sortOrder     Int               @default(0)
  poems         Poem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([sortOrder])
}

model Poem {
  id               String             @id
  title            String
  stanzas          Json               // string[][]
  body             String?            // Derived: stanzas → text (stanza=\n\n, line=\n)
  excerpt          String?            // Derived: first 3 lines of stanza 0
  status           PublicationStatus  @default(DRAFT)
  featured         Boolean            @default(false)

  penNameId        String
  penName          PenName            @relation(fields: [penNameId], references: [id])

  collectionId     String?
  collection       Collection?        @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  literaryWorldId  String?
  literaryWorld    LiteraryWorld?     @relation(fields: [literaryWorldId], references: [id], onDelete: SetNull)

  tags             String[]
  year             String
  linesCount       Int
  readTime         String
  note             String?
  lineNotes        Json?
  coverImage       String?

  sortOrder        Int                @default(0)
  publishedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([penNameId])
  @@index([collectionId])
  @@index([literaryWorldId])
  @@index([status])
  @@index([featured])
  @@index([sortOrder])
  @@index([publishedAt])
}

model Chapbook {
  id          String            @id
  title       String
  authorId    String
  author      PenName           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  description String
  quote       String
  coverImage  String
  price       String
  year        String
  status      PublicationStatus @default(DRAFT)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([sortOrder])
}

enum SubmissionStatus {
  NEW
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model Submission {
  id              String           @id @default(cuid())
  title           String
  manuscript      String           // plain text — parsed to stanzas on accept
  submissionType  String           // "poem" | "chapbook" | "musing"
  submitterName   String
  submitterEmail  String
  submitterBio    String?

  // Optional FK to auth.users.id (no real constraint — matches Person.userId pattern)
  submitterUserId String?
  // Optional preference for which pen name to publish under (if submitter has one)
  preferredPenNameId String?

  status          SubmissionStatus @default(NEW)
  reviewerId      String?          // MemberProfile.id of reviewing admin
  reviewedAt      DateTime?
  rejectionReason String?
  editorialNote   String?

  // Set when admin accepts → creates a DRAFT Poem and links back
  acceptedPoemId  String?          @unique

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([submitterEmail])
  @@index([submitterUserId])
  @@index([createdAt])
}
